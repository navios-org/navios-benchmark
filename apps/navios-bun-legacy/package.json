{
  "name": "@navios-benchmark/navios-bun-legacy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run bundle/main.js",
    "start:compiled": "bundle/server",
    "build": "NODE_ENV=production bun run build.mts",
    "compile": "NODE_ENV=production bun build --compile --outfile bundle/server src/main.mts"
  },
  "dependencies": {
    "@navios/adapter-bun": "^1.0.0",
    "@navios/builder": "^1.0.0",
    "@navios/core": "^1.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  }
}

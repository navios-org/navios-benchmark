{
  "name": "@navios-benchmark/root",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "yarn build:loadgen && yarn build:apps",
    "build:apps": "tsc -b",
    "build:loadgen": "cd loadgen && go build -o bin/loadgen .",
    "build:packages": "node bench/cli.mts package",
    "bench": "node bench/cli.mts run",
    "bench:quick": "node bench/cli.mts run --preset quick",
    "bench:full": "node bench/cli.mts run --preset full",
    "calibrate": "node bench/cli.mts calibrate",
    "conformance": "node bench/cli.mts conformance",
    "report": "node bench/cli.mts report",
    "list": "node bench/cli.mts list",
    "test": "yarn test:loadgen && yarn test:bench",
    "test:loadgen": "cd loadgen && go vet ./... && go test ./...",
    "test:bench": "node --test 'bench/**/*.spec.mts'",
    "check": "tsc -b && tsc -p bench",
    "lint": "oxlint apps shared bench",
    "format": "oxfmt apps shared bench"
  },
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "devDependencies": {
    "@types/node": "26.6.6",
    "autocannon": "8.0.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "rolldown": "1.3.3",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "zod": "4.6.7"
  }
}

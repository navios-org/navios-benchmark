{
  "name": "@navios-benchmark/root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "bench": "tsx runner.ts",
    "bench:cold-start": "tsx runner.ts --scenario=cold-start",
    "bench:light": "tsx runner.ts --scenario=light-load",
    "bench:moderate": "tsx runner.ts --scenario=moderate-load",
    "bench:heavy": "tsx runner.ts --scenario=heavy-load",
    "bench:sustained": "tsx runner.ts --scenario=sustained-load",
    "bench:all": "tsx runner.ts --all",
    "build:all": "yarn workspaces foreach -A run build",
    "start:navios-fastify": "yarn workspace @navios-benchmark/navios-fastify start",
    "start:navios-bun": "yarn workspace @navios-benchmark/navios-bun start",
    "start:nestjs-express": "yarn workspace @navios-benchmark/nestjs-express start",
    "start:nestjs-fastify": "yarn workspace @navios-benchmark/nestjs-fastify start",
    "start:native-bun": "yarn workspace @navios-benchmark/native-bun start"
  },
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^25.0.3",
    "autocannon": "^8.0.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "ora": "^8.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
